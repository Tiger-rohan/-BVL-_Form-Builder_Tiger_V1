# ==============================================================================
# FormForge Environment Configuration
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Secret key used for signing and verifying user session JWT tokens
# In production, replace this with any random 32+ character string
JWT_SECRET=formforge_super_secure_jwt_secret_change_me_in_production

# ==============================================================================
# (OPTIONAL) External Database Configuration
# FormForge runs OUT OF THE BOX with ZERO external database configuration!
# It automatically uses its built-in local database engine (PGlite in ./data/postgres).
# 
# Only uncomment and fill these in if you WANT to connect an external database:
# ==============================================================================
# DATABASE_URL=postgresql://postgres:password@localhost:5432/formforge
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
